POSTGRES_USER=shortly
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=shortly
POSTGRES_PORT=5432
API_PORT=3333
WEB_PORT=4200
WEB_ORIGIN=http://localhost:4200

DATABASE_URL=postgresql://shortly:replace-with-local-password@localhost:5432/shortly?schema=public
DATABASE_URL_TEST=postgresql://shortly:replace-with-local-password@localhost:5432/shortly_test?schema=public
COOKIE_SECURE=false

REDIS_URL=redis://localhost:6767
REDIS_URL_TEST=redis://localhost:6767
REDIRECT_CACHE_TTL_SECONDS=300
REDIS_PORT=6767

# Local email verification (Mailpit inbox: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Shortly <no-reply@shortly.test>
EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Explicit local-only database seeding
ALLOW_DEVELOPMENT_SEED=false
SEED_DEMO_PASSWORD=replace-with-local-demo-password
SEED_PENDING_PASSWORD=replace-with-local-pending-password
